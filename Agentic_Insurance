def format_currency(amount):
    if amount is None or pd.isna(amount):
        return "$0.00"
    val = float(amount)
    if abs(val) >= 1e9:
        return f"${val / 1e9:,.2f}B"
    elif abs(val) >= 1e6:
        return f"${val / 1e6:,.2f}M"
    elif abs(val) >= 1e3:
        return f"${val / 1e3:,.2f}K"
    else:
        return f"${val:,.2f}"

def format_number(value):
    if value is None or pd.isna(value):
        return "0"
    return f"{int(value):,}"

# To check the customer id format
def sanitize_id(value):
    """Validate that a value looks like a safe identifier (alphanumeric + hyphens/underscores)."""
    if not re.match(r'^[A-Za-z0-9_\-]+$', str(value)):
        raise ValueError(f"Invalid identifier: {value}")
    return str(value)

#  To remove single quote in order to avoid error while execution
def escape_sql_string(value):
    """Escape single quotes for SQL string literals."""
    return str(value).replace("'", "''")

def generate_calc_id():
    """Generate a short unique CALC_ID that fits VARCHAR(20). Format: C-YYMMDDHHMMSSxx (max 17 chars)."""
    ts = datetime.now().strftime("%y%m%d%H%M%S")
    suffix = hashlib.md5(str(datetime.now().timestamp()).encode()).hexdigest()[:2].upper()
    return f"C-{ts}{suffix}"


# Constructs a JSON request payload, calls SNOWFLAKE.CORTEX.DATA_AGENT_RUN through Snowpark session SQL, and extracts the text response and metadata thread_id.
def call_agent(agent_fqn, messages, thread_id=None, parent_message_id=None):
    """Call a Cortex Agent via DATA_AGENT_RUN and return (text, thread_id, message_id)."""
    msg_list = []
    for m in messages:
        msg_list.append({
            "role": m["role"],
            "content": [{"type": "text", "text": m["content"]}]
        })

    request_body = {"messages": msg_list, "stream": False}
    if thread_id is not None:
        request_body["thread_id"] = thread_id
        if parent_message_id is not None:
            request_body["parent_message_id"] = parent_message_id

    sql = f"""
        SELECT TRY_PARSE_JSON(
            SNOWFLAKE.CORTEX.DATA_AGENT_RUN(
                '{agent_fqn}',
                $${json.dumps(request_body)}$$,
                TRUE
            )
        ) AS RESP
    """
    result = session.sql(sql).to_pandas()
    resp = result["RESP"].iloc[0]

    if isinstance(resp, str):
        resp = json.loads(resp)

    text_parts = []
    if resp and "content" in resp:
        for block in resp["content"]:
            if block.get("type") == "text":
                text_parts.append(block["text"])

    metadata = resp.get("metadata", {}) if resp else {}
    thread = metadata.get("thread_id")
    message_id = metadata.get("message_id")
    return "\n".join(text_parts) if text_parts else "No response from agent.", thread, message_id

# Builds a reusable Streamlit UI component for chatting with any Cortex Agent, complete with pre-configured quick-question chips, message history, and clear-chat capabilities.
def render_agent_chat(agent_key, agent_fqn, agent_label, sample_questions, system_prompt=None):
    """Render a chat panel for a Cortex Agent with session state."""
    state_key = f"agent_messages_{agent_key}"
    thread_key = f"agent_thread_{agent_key}"
    parent_msg_key = f"agent_parent_msg_{agent_key}"

    if state_key not in st.session_state:
        st.session_state[state_key] = []
    if thread_key not in st.session_state:
        st.session_state[thread_key] = None
    if parent_msg_key not in st.session_state:
        st.session_state[parent_msg_key] = None

    with st.expander(f"🤖 Ask {agent_label}", expanded=False):
        st.caption(f"Chat with the **{agent_label}** to get AI-powered insights.")

        def _build_messages():
            msgs = list(st.session_state[state_key])
            if system_prompt and msgs:
                msgs[0] = {
                    "role": msgs[0]["role"],
                    "content": system_prompt + "\n\n" + msgs[0]["content"]
                }
            return msgs

        # Sample question chips
        sq_cols = st.columns(len(sample_questions))
        for i, q in enumerate(sample_questions):
            if sq_cols[i].button(q, key=f"{agent_key}_sq_{i}", use_container_width=True):
                st.session_state[state_key].append({"role": "user", "content": q})
                with st.spinner("Agent is thinking..."):
                    answer, tid, mid = call_agent(
                        agent_fqn,
                        _build_messages(),
                        st.session_state[thread_key],
                        st.session_state[parent_msg_key]
                    )
                st.session_state[state_key].append({"role": "assistant", "content": answer})
                if tid:
                    st.session_state[thread_key] = tid
                if mid:
                    st.session_state[parent_msg_key] = mid
                st.rerun()

        # Display conversation history
        for msg in st.session_state[state_key]:
            with st.chat_message(msg["role"]):
                st.markdown(msg["content"])

        # Chat input
        user_input = st.text_input(
            "Ask a question...",
            key=f"{agent_key}_input",
            placeholder=f"e.g. {sample_questions[0] if sample_questions else 'Ask anything...'}"
        )
        if st.button("Send", key=f"{agent_key}_send") and user_input:
            st.session_state[state_key].append({"role": "user", "content": user_input})
            with st.spinner("Agent is thinking..."):
                answer, tid, mid = call_agent(
                    agent_fqn,
                    _build_messages(),
                    st.session_state[thread_key],
                    st.session_state[parent_msg_key]
                )
            st.session_state[state_key].append({"role": "assistant", "content": answer})
            if tid:
                st.session_state[thread_key] = tid
            if mid:
                st.session_state[parent_msg_key] = mid
            st.rerun()

        if st.session_state[state_key]:
            if st.button("Clear conversation", key=f"{agent_key}_clear"):
                st.session_state[state_key] = []
                st.session_state[thread_key] = None
                st.session_state[parent_msg_key] = None
                st.rerun()


def generate_pdf_report(kpi_data, chart_dataframes, title="Executive Dashboard Report"):
    """Generate a PDF report with all KPIs, tables, and chart data."""
    from reportlab.lib import colors
    from reportlab.lib.pagesizes import letter, landscape
    from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle
    from reportlab.lib.units import inch
    from reportlab.platypus import SimpleDocTemplate, Table, TableStyle, Paragraph, Spacer, PageBreak
    from reportlab.lib.enums import TA_CENTER, TA_LEFT

    buf = io.BytesIO()
    doc = SimpleDocTemplate(buf, pagesize=landscape(letter), topMargin=0.5*inch, bottomMargin=0.5*inch)
    styles = getSampleStyleSheet()
    title_style = ParagraphStyle('CustomTitle', parent=styles['Title'], fontSize=20, spaceAfter=20, alignment=TA_CENTER)
    section_style = ParagraphStyle('Section', parent=styles['Heading2'], fontSize=14, spaceAfter=10, spaceBefore=15, textColor=colors.HexColor('#1a5276'))
    caption_style = ParagraphStyle('Caption', parent=styles['Normal'], fontSize=8, textColor=colors.grey, alignment=TA_CENTER)

    elements = []
    elements.append(Paragraph(title, title_style))
    elements.append(Paragraph(f"Generated: {datetime.now().strftime('%Y-%m-%d %H:%M')}", caption_style))
    elements.append(Spacer(1, 20))

    # KPI Summary Table
    if kpi_data:
        elements.append(Paragraph("Key Portfolio Indicators", section_style))
        kpi_table_data = [["Metric", "Value"]]
        for k, v in kpi_data.items():
            kpi_table_data.append([str(k), str(v)])
        t = Table(kpi_table_data, colWidths=[3.5*inch, 3*inch])
        t.setStyle(TableStyle([
            ('BACKGROUND', (0, 0), (-1, 0), colors.HexColor('#1a5276')),
            ('TEXTCOLOR', (0, 0), (-1, 0), colors.white),
            ('FONTSIZE', (0, 0), (-1, 0), 10),
            ('FONTSIZE', (0, 1), (-1, -1), 9),
            ('ALIGN', (0, 0), (-1, -1), 'LEFT'),
            ('GRID', (0, 0), (-1, -1), 0.5, colors.grey),
            ('ROWBACKGROUNDS', (0, 1), (-1, -1), [colors.white, colors.HexColor('#eaf2f8')]),
            ('TOPPADDING', (0, 0), (-1, -1), 4),
            ('BOTTOMPADDING', (0, 0), (-1, -1), 4),
        ]))
        elements.append(t)
        elements.append(Spacer(1, 15))

    # Data tables
    for df_name, df in chart_dataframes.items():
        if df is not None and not df.empty:
            elements.append(Paragraph(df_name, section_style))
            headers = list(df.columns)
            table_data = [headers]
            for _, row in df.head(50).iterrows():
                table_data.append([str(v)[:40] for v in row.values])
            col_count = len(headers)
            available_width = 9.5 * inch
            col_w = available_width / col_count
            t = Table(table_data, colWidths=[col_w]*col_count, repeatRows=1)
            t.setStyle(TableStyle([
                ('BACKGROUND', (0, 0), (-1, 0), colors.HexColor('#2c3e50')),
                ('TEXTCOLOR', (0, 0), (-1, 0), colors.white),
                ('FONTSIZE', (0, 0), (-1, 0), 8),
                ('FONTSIZE', (0, 1), (-1, -1), 7),
                ('ALIGN', (0, 0), (-1, -1), 'CENTER'),
                ('GRID', (0, 0), (-1, -1), 0.5, colors.lightgrey),
                ('ROWBACKGROUNDS', (0, 1), (-1, -1), [colors.white, colors.HexColor('#f8f9fa')]),
                ('TOPPADDING', (0, 0), (-1, -1), 3),
                ('BOTTOMPADDING', (0, 0), (-1, -1), 3),
            ]))
            elements.append(t)
            elements.append(Spacer(1, 10))

    doc.build(elements)
    buf.seek(0)
    return buf.getvalue()


